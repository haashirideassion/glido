{
  "name": "glido",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch --env-file .env src/app.ts",
    "build": "tsc --noEmit",
    "start": "tsx src/app.ts",
    "css": "tailwindcss -i src/public/input.css -o src/public/styles.css --watch",
    "css:build": "tailwindcss -i src/public/input.css -o src/public/styles.css --minify",
    "vercel-build": "npm run css:build && mkdir -p public/public && cp src/public/alpine-init.js src/public/kiosk.css src/public/styles.css src/public/transitions.js public/public/"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@kiwa-ui/enhance": "^2.0.0",
    "@supabase/supabase-js": "^2.105.4",
    "@types/nodemailer": "^8.0.0",
    "@types/qrcode": "^1.5.6",
    "clsx": "^2.1.1",
    "hono": "^4.7.0",
    "lucide": "^0.575.0",
    "nodemailer": "^8.0.7",
    "qrcode": "^1.5.4",
    "tailwind-merge": "^3.5.0",
    "ws": "^8.20.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
