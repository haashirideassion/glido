    "css": "tailwindcss -i src/public/input.css -o src/public/styles.css --watch",
    "css:build": "tailwindcss -i src/public/input.css -o src/public/styles.css --minify"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@kiwa-ui/enhance": "^2.0.0",
    "clsx": "^2.1.1",
    "hono": "^4.7.0",
    "lucide": "^0.575.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.0",
    "@types/node": "^22.0.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
